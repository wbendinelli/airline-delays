# Heavy or generated data layers -- tracked only via their README.md (and,
# for data/raw/, the fetch manifest). See CLAUDE.md and DECISIONS.md:
# nothing else from these directories is ever committed.
/data/raw/*
!/data/raw/README.md
!/data/raw/manifest.json
/data/staged/*
!/data/staged/README.md
/data/derived/*
!/data/derived/README.md

# data/analysis/ is a tracked directory, and since DECISIONS.md ADR-0014 its
# *.parquet and *.csv.gz tables are tracked too -- the panel and fact table
# are 2-12 MB, the pre-commit large-file threshold below is raised to match,
# and `just check-analysis` fails a commit where they drift from the
# registry or the fact table. They are still rebuilt from data/staged/ by
# `just features && just panel` in about 22 seconds, and they still go to
# Zenodo at publication alongside the flight table (ADR-0004) -- tracking
# them here is so a reviewer can run the public replication without
# rebuilding, not a replacement for that.
/data/analysis/*
!/data/analysis/README.md
!/data/analysis/manifest.json
!/data/analysis/panel_manifest.json
!/data/analysis/article_panel_manifest.json
!/data/analysis/*.parquet
!/data/analysis/*.csv.gz

.venv/
__pycache__/
*.py[cod]
*.duckdb
.ruff_cache/
.pytest_cache/
.DS_Store

reports/**/build
